#!/usr/bin/env bash
# Copy a box's signed report on itself into fleet/boxes/<box>/:
#
#   scripts/box-report node2 [address]
#
# The box makes it at every boot (nix/modules/box/report.nix); the
# box-reports check refuses anything it did not sign, so this is the only
# way those files change.
set -eu
box=$1
here=$(cd "$(dirname "$0")/.." && pwd)
addr=${2:-$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]]["net"])' "$here/fleet/boxes.json" "$box")}
dir="$here/fleet/boxes/$box"
mkdir -p "$dir"
for f in hardware-configuration.nix hardware.json report.sig; do
  ssh -o BatchMode=yes "admin@$addr" cat "/var/lib/dd/report/$f" > "$dir/$f.new"
done
for f in hardware-configuration.nix hardware.json report.sig; do mv "$dir/$f.new" "$dir/$f"; done
git -C "$here" diff --stat -- "fleet/boxes/$box"
