#!/usr/bin/env bash
# After scripts/install-box: put back what lived on the box's boot disk.
#
#   scripts/restore-box node1
#
# The box came back with its identity (host key, network node, uid map, the
# verifier's state, its store's metadata) and its other pools untouched;
# what the boot disk held is in two places: the box's restic backup in its
# own store, copied to another box's, and, for postgres, the hourly dumps on
# the bulk pool. This brings back any bucket its store lost from a copy on
# another box's store, restores the backed-up directories, the network's
# database where this box runs the control server, loads the database dumps,
# and starts everything again.
set -euo pipefail

box=${1:?box}
# Where the box is: its address on the fleet's network from the fleet's own
# list, or DD_ADDR when that network is the thing that is broken (the house LAN, say:
# DD_ADDR=admin@192.168.1.20). This used to name a direct cable that no
# longer exists, which left the one way in for when releases fail pointing
# at nothing.
repo=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
addr=${DD_ADDR:-}
if [ -z "$addr" ]; then
  net=$(jq -er --arg b "$box" '.[$b].net' "$repo/fleet/boxes.json") \
    || { echo "no box $box in fleet/boxes.json" >&2; exit 1; }
  addr=admin@$net
fi
# the other boxes' stores, where this box's buckets have their copies
domain=$(jq -r .domain "$repo/fleet/policy.json")
peers=$(jq -r --arg b "$box" --arg d "$domain" 'keys[] | select(. != $b) | "https://store.\(.).\($d):3443"' "$repo/fleet/boxes.json" | tr '\n' ' ')
# shellcheck disable=SC2029 # the names expand here on purpose
ssh "$addr" "sudo BOX=$box PEERS='$peers' bash -s" <<'EOF'
set -euo pipefail
if command -v garage >/dev/null; then
  echo "== garage back in the cluster"
  for _ in $(seq 1 120); do
    n=$(garage status 2>/dev/null | grep -cE '^[0-9a-f]{16}\s' || true)
    [ "$n" -ge 2 ] && break
    sleep 5
  done
  garage status | tail -n +2
  # this box's blocks are still on its data dir; tell the index so
  garage repair -a --yes blocks >/dev/null
  garage repair -a --yes tables >/dev/null
fi

echo "== this box's store"
# install-box carries the store's metadata in, so its buckets are as they
# were. A box that came back without it has an empty store: each bucket
# empty here is copied back from a copy on another box's store, with the key
# that store sealed to this box. Copying only: nothing is deleted anywhere
if systemctl cat dd-store.service >/dev/null 2>&1; then
  systemctl start dd-store-setup.service
  p=$(systemctl show -p Environment --value dd-store-copy.service | tr ' ' '\n' | sed -n 's/^PATH=//p')
  for b in $(dd-store-garage bucket list | awk 'NR > 1 && $1 != "" { print $1 }'); do
    n=$(dd-store-garage bucket info "$b" | awk '/^Objects:/ { print $2 }')
    [ "${n:-0}" = 0 ] || continue
    for url in $PEERS; do
      peer=${url#https://store.}; peer=${peer%%.*}
      ( export PATH=$p:$PATH RCLONE_CONFIG=/dev/null
        k=$(mktemp)
        curl -fsS --max-time 30 "$url/_keys/$BOX.age" | age -d -i /var/lib/dd/secrets-key.txt > "$k" || exit 1
        set -a; . "$k"; set +a; rm -f "$k"
        export RCLONE_CONFIG_THERE_TYPE=s3 RCLONE_CONFIG_THERE_PROVIDER=Other RCLONE_CONFIG_THERE_ENDPOINT="$url" \
          RCLONE_CONFIG_THERE_REGION=us-east-1 RCLONE_CONFIG_THERE_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID \
          RCLONE_CONFIG_THERE_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY RCLONE_CONFIG_THERE_FORCE_PATH_STYLE=true
        [ -n "$(rclone lsf --files-only --max-depth 1 "there:$b" 2>/dev/null | head -1)" ] || exit 1
        set -a; . "/var/lib/dd-store/keys/$b.env"; set +a
        export RCLONE_CONFIG_HERE_TYPE=s3 RCLONE_CONFIG_HERE_PROVIDER=Other RCLONE_CONFIG_HERE_ENDPOINT=http://127.0.0.1:3910 \
          RCLONE_CONFIG_HERE_REGION=us-east-1 RCLONE_CONFIG_HERE_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID \
          RCLONE_CONFIG_HERE_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY RCLONE_CONFIG_HERE_FORCE_PATH_STYLE=true
        rclone copy --s3-no-check-bucket --fast-list "there:$b" "here:$b"
      ) && { echo "   $b from $peer's copy"; break; }
    done
  done
fi

echo "== restic restore of the backed-up directories"
# the units that own them are stopped first; a running service would
# write over what comes back. A box runs some of them, not all
units=
for u in prometheus thanos-sidecar headscale dd-games ente forgejo vaultwarden; do
  systemctl cat "$u.service" >/dev/null 2>&1 && units="$units $u"
done
# shellcheck disable=SC2086 # a list of names
[ -z "$units" ] || systemctl stop $units
# reads only, so no lock: a lock is a write, and the cluster takes none with
# a box down - which is when a restore happens
for _ in $(seq 1 60); do restic-dd --no-lock snapshots >/dev/null 2>&1 && break; sleep 5; done
restic-dd --no-lock snapshots | tail -3
# only what lives on the boot disk: the pool paths are still there. The
# verifier's state came with the box (install-box), newer than any backup
paths="/var/lib/prometheus2 /var/lib/garage/meta/snapshots /var/lib/headscale/snapshot
  /var/lib/dd-games/instances /var/lib/dd-games/records /var/lib/dd-games/players /var/lib/dd-games/worlds"
[ -n "$(ls -A /var/lib/dd-verify 2>/dev/null)" ] || paths="$paths /var/lib/dd-verify"
for p in $paths; do
  if restic-dd --no-lock ls latest "$p" >/dev/null 2>&1; then
    echo "   $p"
    restic-dd --no-lock restore latest --include "$p" --target / >/dev/null
  fi
done

# the network's members and the server's key: a fresh control server knows
# only this box, and every other device would have to join again
hs=/var/lib/headscale
if [ -s $hs/snapshot/db.sqlite ]; then
  # the table's rows, past its header
  nodes=$(headscale nodes list 2>/dev/null | tail -n +2 | grep -c . || true)
  if [ "${nodes:-0}" -le 1 ]; then
    echo "== the network's database from the snapshot"
    systemctl stop headscale
    rm -f $hs/db.sqlite-wal $hs/db.sqlite-shm
    install -o headscale -g headscale -m 0600 $hs/snapshot/db.sqlite $hs/db.sqlite
    install -o headscale -g headscale -m 0600 $hs/snapshot/noise_private.key $hs/noise_private.key
  else
    echo "   the network has $nodes nodes already, leaving it"
  fi
fi

echo "== postgres from the dumps"
dumps=/vault/backups/postgres
if [ -d $dumps ]; then
  systemctl start postgresql
  for f in "$dumps"/*.sql.zstd; do
    [ -s "$f" ] || continue
    db=$(basename "$f" .sql.zstd)
    # the table that holds what matters, per database
    case $db in
      ente) marker=key_attributes ;;
      forgejo) marker=repository ;;
      vaultwarden) marker=users ;;
      *) echo "   $db: no marker table known, leaving it" >&2; continue ;;
    esac
    # the service's own role owns the database, so it owns what comes back
    if ! sudo -u postgres psql -tAc "select 1 from pg_database where datname='$db'" | grep -q 1; then
      sudo -u postgres psql -q -c "create database $db owner $db"
    fi
    # the service has usually started once by now and run its migrations:
    # tables exist, empty. Data is the test, in the table that matters
    rows=$(sudo -u postgres psql -tAd "$db" -c "select count(*) from $marker" 2>/dev/null || echo 0)
    if [ "$rows" -gt 0 ]; then echo "   $db has $rows rows in $marker, leaving it"; continue; fi
    echo "   $db from the dump of $(date -r "$f" +%H:%M)"
    sudo -u postgres psql -q -c "drop database $db"
    sudo -u postgres psql -q -c "create database $db owner $db"
    zstd -dc "$f" | sudo -u "$db" psql -q -v ON_ERROR_STOP=1 -d "$db" >/dev/null
  done
fi

echo "== start"
# shellcheck disable=SC2086
[ -z "$units" ] || systemctl start $units || true
sleep 5
systemctl --failed --no-legend
echo "== done"
EOF
