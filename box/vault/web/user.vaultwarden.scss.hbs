/* Commonty's look on Vaultwarden's own pages, through the hook it keeps for
   this (TEMPLATES_FOLDER, modules/vault/vaultwarden.nix): the web vault is
   themed by Tailwind colour variables, space-separated rgb, and these set
   them to the Commonty palette (box/web/home.css). Only colours and type
   change; every page and control is still Bitwarden's. */

@font-face {
  font-family: "Public Sans";
  src: url("/_dd/static/public-sans.woff2") format("woff2");
  font-weight: 100 900;
  font-display: swap;
}

:root,
.theme_light {
  --color-primary-100: 222 236 229;
  --color-primary-300: 125 176 150;
  --color-primary-600: 29 92 66;
  --color-primary-700: 18 61 43;

  --color-secondary-100: 227 230 225;
  --color-secondary-300: 213 217 211;
  --color-secondary-600: 82 90 85;
  --color-secondary-700: 26 31 28;

  --color-info-100: 227 236 245;
  --color-info-600: 29 68 112;
  --color-info-700: 22 48 79;

  --color-warning-100: 246 236 217;
  --color-warning-600: 138 90 18;
  --color-warning-700: 110 71 12;

  --color-background: 255 255 255;
  --color-background-alt: 238 241 245;
  --color-background-alt2: 29 68 112;
  --color-background-alt3: 22 48 79;
  --color-background-alt4: 18 36 58;

  --color-text-main: 26 31 28;
  --color-text-muted: 82 90 85;
  --color-text-contrast: 255 255 255;
  --color-text-alt2: 255 255 255;
  --color-text-code: 29 92 66;

  --tw-ring-offset-color: #EEF1F5;
}

.theme_dark {
  --color-primary-100: 21 44 34;
  --color-primary-300: 58 148 105;
  --color-primary-600: 124 203 162;
  --color-primary-700: 168 224 194;

  --color-secondary-100: 34 40 49;
  --color-secondary-300: 42 49 59;
  --color-secondary-600: 161 169 179;
  --color-secondary-700: 229 233 238;

  --color-info-100: 27 40 56;
  --color-info-600: 156 195 234;
  --color-info-700: 127 174 221;

  --color-warning-100: 46 38 22;
  --color-warning-600: 227 183 105;
  --color-warning-700: 240 205 140;

  --color-background: 23 28 34;
  --color-background-alt: 15 19 24;
  --color-background-alt2: 22 48 79;
  --color-background-alt3: 18 36 58;
  --color-background-alt4: 13 26 42;

  --color-text-main: 229 233 238;
  --color-text-muted: 161 169 179;
  --color-text-contrast: 15 19 24;
  --color-text-alt2: 255 255 255;
  --color-text-code: 124 203 162;

  --tw-ring-offset-color: #0F1318;
}

html,
body,
.tw-font-sans {
  font-family: "Public Sans", "Segoe UI", Helvetica, Arial, sans-serif !important;
}

/* squarer, like every other Commonty page */
.tw-rounded-lg,
.tw-rounded-xl,
.tw-rounded-full[bitbutton],
button[bitbutton],
a[bitbutton] {
  border-radius: 4px !important;
}

/* the logo on the sign-in and sign-up pages is Bitwarden's product mark:
   Commonty's bar is above it already */
bit-landing-layout bit-landing-header svg,
auth-anon-layout .logo {
  display: none !important;
}
