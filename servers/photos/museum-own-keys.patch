new file mode 100644
index 0000000..ae23437
--- /dev/null
+++ b/cmd/museum/dd_jobs.go
@@ -0,0 +1,65 @@
+package main
+
+// Commonty: what museum's admin api did for the fleet, done in museum by
+// the box itself, with no admin account and nothing reachable over the
+// network. An account is deleted only when the box lists its address in
+// dd_delete, which it does only for a member whose own signed leaving (or
+// the release-signed member list) says so (nix/modules/storage/ledger.nix).
+
+import (
+	"context"
+	"database/sql"
+	"time"
+
+	"github.com/ente-io/museum/pkg/controller/user"
+	log "github.com/sirupsen/logrus"
+)
+
+func ddDeleteLoop(db *sql.DB, users *user.UserController) {
+	if _, err := db.Exec(`CREATE TABLE IF NOT EXISTS dd_delete (email TEXT PRIMARY KEY, asked TIMESTAMP NOT NULL DEFAULT NOW())`); err != nil {
+		log.Fatalf("dd delete: %v", err)
+	}
+	for {
+		ddDeleteDue(db, users)
+		time.Sleep(30 * time.Second)
+	}
+}
+
+func ddDeleteDue(db *sql.DB, users *user.UserController) {
+	rows, err := db.Query(`SELECT d.email, u.user_id FROM dd_delete d LEFT JOIN users u ON u.dd_email = d.email AND u.encrypted_email IS NOT NULL`)
+	if err != nil {
+		log.Printf("dd delete: %v", err)
+		return
+	}
+	type due struct {
+		email string
+		id    sql.NullInt64
+	}
+	var all []due
+	for rows.Next() {
+		var d due
+		if rows.Scan(&d.email, &d.id) == nil {
+			all = append(all, d)
+		}
+	}
+	rows.Close()
+	for _, d := range all {
+		if d.id.Valid {
+			logger := log.WithFields(log.Fields{"user_id": d.id.Int64, "req_ctx": "dd_member_left"})
+			if _, err := users.HandleAutomatedAccountDeletion(context.Background(), d.id.Int64, logger); err != nil {
+				log.Printf("dd delete %d: %v", d.id.Int64, err)
+				continue
+			}
+			// its address goes too: nothing rebuilds a deleted account
+			// under new keys (dd_rekey)
+			if _, err := db.Exec(`UPDATE users SET dd_email = NULL WHERE user_id = $1`, d.id.Int64); err != nil {
+				log.Printf("dd delete %d: %v", d.id.Int64, err)
+				continue
+			}
+			log.Printf("dd delete: account %d deleted, its member having left", d.id.Int64)
+		}
+		if _, err := db.Exec(`DELETE FROM dd_delete WHERE email = $1`, d.email); err != nil {
+			log.Printf("dd delete: %v", err)
+		}
+	}
+}
diff --git a/cmd/museum/dd_rekey.go b/cmd/museum/dd_rekey.go
new file mode 100644
index 0000000..c8c4841
--- /dev/null
+++ b/cmd/museum/dd_rekey.go
@@ -0,0 +1,152 @@
+package main
+
+// Commonty: museum's keys are this box's own, made here, and a box that
+// takes photos over starts with keys of its own. What museum encrypted and
+// hashed with the keys before - each account's email - is made again with
+// these, from the address kept beside it (users.dd_email). That address is
+// only ever <member>@users.<the fleet's domain>: a member's name, not a
+// secret. An address outside that domain is never kept, and its account is
+// not carried over to new keys.
+
+import (
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"strings"
+	"time"
+
+	"github.com/ente-io/museum/pkg/utils/crypto"
+	log "github.com/sirupsen/logrus"
+)
+
+func ddFingerprint(enc, hash []byte) string {
+	h := sha256.New()
+	h.Write(enc)
+	h.Write(hash)
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+// ddRekey runs before museum serves anything
+func ddRekey(db *sql.DB, enc, hash []byte, suffix string) {
+	suffix = strings.ToLower(suffix)
+	if suffix == "" {
+		log.Fatal("dd rekey: no local-domain-suffix, so no address can be kept")
+	}
+	for _, q := range []string{
+		`ALTER TABLE users ADD COLUMN IF NOT EXISTS dd_email TEXT`,
+		`CREATE TABLE IF NOT EXISTS dd_keys (id INT PRIMARY KEY, fingerprint TEXT NOT NULL)`,
+	} {
+		if _, err := db.Exec(q); err != nil {
+			log.Fatalf("dd rekey: %v", err)
+		}
+	}
+	fp := ddFingerprint(enc, hash)
+	var was string
+	if err := db.QueryRow(`SELECT fingerprint FROM dd_keys WHERE id = 1`).Scan(&was); err != nil && err != sql.ErrNoRows {
+		log.Fatalf("dd rekey: %v", err)
+	}
+	if was != fp {
+		if err := ddReencrypt(db, enc, hash, fp, was != ""); err != nil {
+			log.Fatalf("dd rekey: %v", err)
+		}
+	}
+	ddKeep(db, enc, suffix)
+	go func() {
+		for {
+			time.Sleep(time.Minute)
+			ddKeep(db, enc, suffix)
+		}
+	}()
+}
+
+// ddReencrypt makes every kept address's email fields again under these
+// keys, and records them as the keys the table is under: all at once
+func ddReencrypt(db *sql.DB, enc, hash []byte, fp string, moved bool) error {
+	tx, err := db.Begin()
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if moved {
+		// live accounts only: a deleted one stays deleted
+		rows, err := tx.Query(`SELECT user_id, dd_email FROM users WHERE dd_email IS NOT NULL AND encrypted_email IS NOT NULL`)
+		if err != nil {
+			return err
+		}
+		type acct struct {
+			id    int64
+			email string
+		}
+		var all []acct
+		for rows.Next() {
+			var a acct
+			if err := rows.Scan(&a.id, &a.email); err != nil {
+				rows.Close()
+				return err
+			}
+			all = append(all, a)
+		}
+		rows.Close()
+		for _, a := range all {
+			e, err := crypto.Encrypt(a.email, enc)
+			if err != nil {
+				return err
+			}
+			h, err := crypto.GetHash(a.email, hash)
+			if err != nil {
+				return err
+			}
+			if _, err := tx.Exec(`UPDATE users SET encrypted_email = $1, email_decryption_nonce = $2, email_hash = $3 WHERE user_id = $4`, e.Cipher, e.Nonce, h, a.id); err != nil {
+				return err
+			}
+		}
+		var lost int
+		if err := tx.QueryRow(`SELECT count(*) FROM users WHERE dd_email IS NULL AND encrypted_email IS NOT NULL`).Scan(&lost); err != nil {
+			return err
+		}
+		// codes asked for under the old keys are for nobody now
+		if _, err := tx.Exec(`DELETE FROM otts`); err != nil {
+			return err
+		}
+		log.Printf("dd rekey: new keys; %d accounts carried over, %d without a kept address are not", len(all), lost)
+	}
+	if _, err := tx.Exec(`INSERT INTO dd_keys (id, fingerprint) VALUES (1, $1) ON CONFLICT (id) DO UPDATE SET fingerprint = $1`, fp); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+// ddKeep keeps the address of every account under the fleet's domain
+// that has none kept yet
+func ddKeep(db *sql.DB, enc []byte, suffix string) {
+	rows, err := db.Query(`SELECT user_id, encrypted_email, email_decryption_nonce FROM users WHERE dd_email IS NULL AND encrypted_email IS NOT NULL`)
+	if err != nil {
+		log.Printf("dd rekey: %v", err)
+		return
+	}
+	type found struct {
+		id    int64
+		email string
+	}
+	var keep []found
+	for rows.Next() {
+		var id int64
+		var c, n []byte
+		if rows.Scan(&id, &c, &n) != nil {
+			continue
+		}
+		email, err := crypto.Decrypt(c, enc, n)
+		if err != nil {
+			continue
+		}
+		if e := strings.ToLower(strings.TrimSpace(email)); strings.HasSuffix(e, suffix) {
+			keep = append(keep, found{id, e})
+		}
+	}
+	rows.Close()
+	for _, f := range keep {
+		if _, err := db.Exec(`UPDATE users SET dd_email = $1 WHERE user_id = $2 AND dd_email IS NULL`, f.email, f.id); err != nil {
+			log.Printf("dd rekey: %v", err)
+		}
+	}
+}
