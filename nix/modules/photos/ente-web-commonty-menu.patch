+/**
+ * Commonty: the account's password is made from the person's passkey (the
+ * site's /_dd/photos page), so nobody knows it to type. The passkey makes
+ * it again here, and it is checked exactly as a typed one would be: the key
+ * it derives must open the master key.
+ */
+const ConfirmWithPasskey: React.FC<{
+    keyAttributes: KeyAttributes;
+    onVerify: () => void;
+}> = ({ keyAttributes, onVerify }) => {
+    const [error, setError] = useState("");
+    const [busy, setBusy] = useState(false);
+
+    const confirm = async () => {
+        setBusy(true);
+        setError("");
+        try {
+            const url = "/_dd/static/photos-passkey.js";
+            const m = (await import(/* webpackIgnore: true */ url)) as {
+                photosPassword: () => Promise<string>;
+            };
+            const password = await m.photosPassword();
+            const kek = await deriveKey(
+                password,
+                keyAttributes.kekSalt,
+                keyAttributes.opsLimit,
+                keyAttributes.memLimit,
+            );
+            await decryptBox(
+                {
+                    encryptedData: keyAttributes.encryptedKey,
+                    nonce: keyAttributes.keyDecryptionNonce,
+                },
+                kek,
+            );
+            onVerify();
+        } catch (e) {
+            log.error("Passkey confirmation failed", e);
+            setError(
+                "That passkey did not confirm it. Try again, or use the device you set your passkey up on.",
+            );
+        } finally {
+            setBusy(false);
+        }
+    };
+
+    return (
+        <Stack sx={{ gap: 2 }}>
+            <Typography sx={{ color: "text.muted" }}>
+                Your passkey confirms it is you. Nothing to type.
+            </Typography>
+            {error && (
+                <Typography variant="small" sx={{ color: "critical.main" }}>
+                    {error}
+                </Typography>
+            )}
+            <FocusVisibleButton
+                color="accent"
+                disabled={busy}
+                onClick={() => void confirm()}
+            >
+                Confirm with your passkey
+            </FocusVisibleButton>
+        </Stack>
+    );
+};
+
